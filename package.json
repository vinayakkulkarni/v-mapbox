{
  "name": "v-mapbox",
  "version": "5.1.0",
  "description": "Maplibre (and Mapbox) with Vue 💚",
  "main": "./dist/v-mapbox.js",
  "module": "./dist/v-mapbox.js",
  "umd": "./dist/v-mapbox.umd.cjs",
  "unpkg": "./dist/v-mapbox.cjs",
  "jsdelivr": "./dist/v-mapbox.cjs",
  "cdn": "./dist/v-mapbox.min.js",
  "exports": {
    ".": {
      "import": "./dist/v-mapbox.js",
      "require": "./dist/v-mapbox.umd.cjs"
    },
    "./dist/v-mapbox.css": {
      "import": "./dist/v-mapbox.css",
      "require": "./dist/v-mapbox.css"
    }
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "rimraf dist && vite build && vue-tsc -p tsconfig.build.json && prettier --write \"./dist/*.{cjs,js,ts}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p docs/.vitepress/tsconfig.json",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs",
    "deploy": "pnpm run docs:build && wrangler deploy",
    "lint": "pnpm run lint:eslint && pnpm run lint:css",
    "lint:fix": "pnpm run lint:eslint:fix && pnpm run lint:css:fix",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "lint:css": "stylelint \"{src,docs}/**/*.{css,scss,vue}\"",
    "lint:css:fix": "stylelint --fix \"{src,docs}/**/*.{css,scss,vue}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "is-ci || husky",
    "release": "shipjs prepare",
    "release:auto": "shipjs prepare --yes",
    "release:dry": "shipjs prepare --dry-run"
  },
  "peerDependencies": {
    "maplibre-gl": "^6.0.0",
    "vue": "^3.5.0"
  },
  "optionalDependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.4.0",
    "@eslint/js": "^10.0.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@vinayakkulkarni/prettier-config-vue": "^1.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^17.6.0",
    "maplibre-gl": "^6.15.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "sass": "^1.106.1",
    "shipjs": "^0.28.4",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-prettier": "^5.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.152.0"
  },
  "keywords": [
    "vue",
    "vuejs",
    "mapbox",
    "mapbox-gl-js",
    "mapbox-gl",
    "maplibre-gl-js",
    "maplibre-gl"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "author": {
    "name": "Vinayak Kulkarni",
    "email": "inbox.vinayak@gmail.com",
    "url": "https://vinayakkulkarni.dev"
  },
  "contributors": [
    {
      "email": "developers@geospoc.com",
      "name": "GeoSpoc Dev Team",
      "url": "https://geospoc.com"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinayakkulkarni/v-mapbox.git"
  },
  "private": false,
  "sideEffects": [
    "*.css"
  ],
  "bugs": {
    "url": "https://github.com/vinayakkulkarni/v-mapbox/issues"
  },
  "homepage": "https://v-mapbox.vinayakkulkarni.dev",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.x"
    }
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
